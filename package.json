{
  "name": "realestate-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prepareCloudflarePages.js",
    "deploy": "npx wrangler pages deploy dist --project-name=chikashiru",
    "sitemap": "node scripts/generateSitemap.js",
    "snapshot": "node scripts/generateSsrSnapshot.js",
    "d1:export": "node scripts/exportMysqlToD1.js",
    "d1:export:all": "node scripts/exportMysqlToD1.js --all",
    "d1:import:local": "node scripts/importToD1.js --local",
    "d1:import:remote": "node scripts/importToD1.js --remote",
    "prepare": "git config core.hooksPath .githooks",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "astro": "^7.3.8",
    "mysql2": "^3.24.5"
  }
}
