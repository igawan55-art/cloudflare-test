---
import { buildWebSiteSchema } from '../lib/structuredData.js';
import { buildCanonicalUrl, SITE_NAME, SITE_URL } from '../lib/siteConfig.js';

export interface Props {
    title: string;
    description?: string;
    canonical?: string;
    ogType?: string;
    ogImage?: string;
    jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
    title,
    description = "国土交通省「不動産情報ライブラリ」の公的データをもとに、全国のエリア別不動産取引価格・相場推移をわかりやすく可視化する相場検索サイトです。",
    canonical,
    ogType = Astro.url.pathname === '/' ? 'website' : 'article',
    ogImage = `${SITE_URL}/assets/images/background.jpg`,
    jsonLd = null
} = Astro.props;

// canonical が指定されていればそれを使用し、未指定の場合は現在のパスから自動生成（SITE_URL一括反映）
const canonicalHref = buildCanonicalUrl(canonical || Astro.url.pathname);

// Cloudflare CDN エッジキャッシュ設定（SSR時に1度生成したページをエッジに24時間キャッシュし、2回目以降を0.01秒の静的配信化）
if (Astro.response?.headers && !Astro.response.headers.has('Cache-Control')) {
    Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800');
}

// 全ページ共通の WebSite スキーマ
const websiteSchema = buildWebSiteSchema();

// ページ独自の jsonLd（単一オブジェクトまたは配列）を結合
const schemasToRender: any[] = [websiteSchema];
if (jsonLd) {
    if (Array.isArray(jsonLd)) {
        schemasToRender.push(...jsonLd.filter(Boolean));
    } else {
        schemasToRender.push(jsonLd);
    }
}
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#1E3A8A">
    <title>{title}</title>
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="apple-touch-icon" href="/assets/images/logo.svg">

    <!-- Open Graph / Facebook / LINE -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalHref} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/assets/css/style.css">
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    {schemasToRender.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <slot name="head" />
</head>
<body>
    <header class="site-header">
        <div class="container bar">
            <a href="/" class="brand" aria-label="チカシル トップへ">
                <span class="brand-logo-wrap">
                    <img src="/assets/images/logo.svg" alt="チカシル" class="brand-logo" width="140" height="39" />
                </span>
                <span class="brand-text">
                    <span class="brand-name sr-only">チカシル</span>
                    <span class="brand-tagline">不動産の取引価格、路線価、公示価格、地価を知る - チカシル</span>
                </span>
            </a>
            <nav class="site-nav" aria-label="メインメニュー">
                <a href="/">トップ</a>
                <a href="/areas">エリア一覧</a>
                <a href="/#about-data">データについて</a>
                <a href="/#search" class="is-cta">相場を調べる</a>
            </nav>
        </div>
    </header>

    <main class="main-content">
        <slot />
    </main>

    <footer class="site-footer" id="about-data">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-title">データの出典と集計方法</div>
                    <p class="footer-note">
                        本サイトの取引価格情報は、国土交通省が提供する「不動産情報ライブラリ」API（不動産価格（取引価格・成約価格）情報、鑑定評価書情報）から取得したデータを加工・集計して作成しています。
                        平均価格・㎡単価は取引価格が記録されている事例のみを対象とした単純平均で、坪単価は ㎡単価 × 3.30578 で算出しています。
                        前年比騰落率は、同エリアの地価公示（標準地）の対前年変動率の平均値です。
                    </p>
                    <div class="footer-source">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                        <div>
                            出典：国土交通省 <a href="https://www.reinfolib.mlit.go.jp/" target="_blank" rel="noopener">不動産情報ライブラリ</a><br>
                            <span class="footer-note">このサービスは、国土交通省の不動産情報ライブラリのAPI機能を使用していますが、提供情報の最新性、正確性、完全性等が保証されたものではありません。</span>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="footer-title">ご利用にあたって</div>
                    <p class="footer-note">
                        掲載している相場は過去の取引実績に基づく参考値であり、個別物件の価格や将来の価格を保証するものではありません。
                        実際のお取引にあたっては、不動産会社・不動産鑑定士などの専門家にご相談ください。
                    </p>
                </div>
                <div>
                    <div class="footer-title">サイト情報</div>
                    <ul class="footer-list">
                        <li><a href="/">トップページ</a></li>
                        <li><a href="/#search">エリアから相場を探す</a></li>
                        <li><a href="/terms">利用規約</a></li>
                        <li><a href="/privacy">プライバシーポリシー</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; {new Date().getFullYear()} チカシル</span>
                <span>データ出典：国土交通省 不動産取引価格情報・地価公示（2022年〜最新）</span>
            </div>
        </div>
    </footer>
</body>
</html>
