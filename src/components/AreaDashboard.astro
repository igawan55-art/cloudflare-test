---
// src/components/AreaDashboard.astro
// エリア相場ダッシュボード（実勢取引：KPI・推移グラフ・条件フィルタ・取引事例 ＆ 地価指標：路線価・公示価格・基準地価）
import { generateAreaSummaryHtml } from '../lib/areaSummary.js';
import TaxSimulator from './TaxSimulator.astro';

export interface Props {
    areaName: string;
    prefName?: string;
    cityName?: string;
    districtName?: string;
    stats: { types: Record<string, any> };
    fluctuation: number | null;
    showMunicipality?: boolean;
    initialType?: 'mansion' | 'house' | 'land' | 'rosenka' | 'official' | 'standard';
    landPrices?: any;
}
const {
    areaName,
    prefName = '',
    cityName = '',
    districtName = '',
    stats,
    fluctuation,
    showMunicipality = false,
    initialType = 'mansion',
    landPrices = null,
} = Astro.props;

const isLandPriceInitial = initialType === 'rosenka' || initialType === 'official' || initialType === 'standard';

const TYPE_LABELS: Record<string, string> = {
    mansion: '中古マンション',
    house: '戸建て',
    land: '土地',
    rosenka: '路線価',
    official: '公示価格',
    standard: '基準地価',
};
const currentTypeLabel = TYPE_LABELS[initialType] || '中古マンション';

// 実勢取引ビューの場合のみクライアントJS用ペイロードを生成（該当種別のみ、トップページのみ全種別）
const txTypesPayload = showMunicipality
    ? stats.types
    : { [initialType]: stats?.types?.[initialType] || { count: 0, avgPrice: null, avgSqm: null, avgArea: null, quarters: [], rows: [] } };

const payload = !isLandPriceInitial
    ? JSON.stringify({
          types: txTypesPayload,
          fluctuation,
          showMunicipality,
          initialType,
      }).replace(/</g, '\\u003c')
    : '';

const chip = (filter: string, value: string, label: string) => ({ filter, value, label });
const ageChips = [chip('age', '', 'すべて'), chip('age', '10', '築10年以内'), chip('age', '20', '築20年以内'), chip('age', '30', '築30年以内'), chip('age', 'old', '築30年超')];
const planChips = [chip('plan', '', 'すべて'), chip('plan', '1', '1R〜1LDK'), chip('plan', '2', '2K〜2LDK'), chip('plan', '3', '3K以上')];
const structChips = [chip('struct', '', 'すべて'), chip('struct', 'rc', 'RC・SRC'), chip('struct', 'wood', '木造'), chip('struct', 'other', 'その他')];
const areaChips = initialType === 'mansion'
    ? [chip('area', '', 'すべて'), chip('area', 's', '40㎡未満'), chip('area', 'm', '40〜70㎡'), chip('area', 'l', '70㎡以上')]
    : [chip('area', '', 'すべて'), chip('area', 's', '100㎡未満'), chip('area', 'm', '100〜200㎡'), chip('area', 'l', '200㎡以上')];

const lp = landPrices || { official: {}, standard: {}, rosenka: {}, points: [] };
const off = lp.official || {};
const std = lp.standard || {};
const ros = lp.rosenka || {};
const points = lp.points || [];

const TSUBO = 3.30578;
const DATA_YEAR = new Date().getFullYear();
const fmt1 = (n: number | null | undefined) => (n == null || !isFinite(n) ? '—' : n.toLocaleString('ja-JP', { minimumFractionDigits: 1, maximumFractionDigits: 1 }));
const fmtInt = (n: number | null | undefined) => (n == null || !isFinite(n) ? '—' : Math.round(n).toLocaleString('ja-JP'));
const man1 = (yen: number | null | undefined) => (yen == null || !isFinite(yen) ? '—' : (yen / 10000).toLocaleString('ja-JP', { minimumFractionDigits: 1, maximumFractionDigits: 1 }));
const manInt = (yen: number | null | undefined) => (yen == null || !isFinite(yen) ? '—' : Math.round(yen / 10000).toLocaleString('ja-JP'));
const pct = (v: number | null | undefined) => (v == null || !isFinite(v) ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(2)}%`);
const dcls = (v: number | null | undefined) => (v == null ? 'flat' : v > 0 ? 'up' : v < 0 ? 'down' : 'flat');

// 実勢取引の初期SSRデータ
const currentTx = !isLandPriceInitial ? (stats?.types?.[initialType] || { count: 0, avgPrice: null, avgSqm: null, avgArea: null, quarters: [], rows: [] }) : null;
const initialRows = currentTx?.rows ? currentTx.rows.slice(0, 20) : [];
const isMansion = initialType === 'mansion';
const isLand = initialType === 'land';

// ファーストビュー直下の自動生成要約文（市区町村・町字ページ用）
const summaryHtml = !showMunicipality
    ? generateAreaSummaryHtml({
          pref: prefName,
          city: cityName || areaName,
          district: districtName,
          currentType: initialType,
          stats,
          landPrices,
          fluctuation,
      })
    : '';
---

<div data-dashboard>
    {summaryHtml && (
        <p class="area-summary-text" set:html={summaryHtml} />
    )}
    {!isLandPriceInitial && (
        <>
            <script is:inline type="application/json" set:html={payload}></script>

            <!-- ==================== 1. 実勢取引ビュー (中古マンション / 戸建て / 土地) ==================== -->
            <div data-view="tx">
                <!-- エリア相場サマリー -->
                <section class="section" aria-labelledby="kpi-title">
                    <div class="section-head">
                        <div>
                            <h2 class="section-title" id="kpi-title">{areaName}の{currentTypeLabel}相場サマリー</h2>
                            <p class="section-sub">取引実績（<span data-kpi-type>{currentTypeLabel}</span>）に基づく集計値</p>
                        </div>
                    </div>

                    <div class="kpi-grid">
                        <div class="card kpi">
                            <div class="kpi-label">
                                <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                                平均取引価格
                            </div>
                            <div class="kpi-value"><span data-kpi="price">{manInt(currentTx?.avgPrice)}</span><span class="kpi-unit">万円</span></div>
                            <div class="kpi-note">平均面積 <b class="num"><span data-kpi="avgArea">{fmt1(currentTx?.avgArea)}</span> ㎡</b></div>
                        </div>
                        <div class="card kpi">
                            <div class="kpi-label">
                                <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
                                平均坪単価
                            </div>
                            <div class="kpi-value"><span data-kpi="tsubo">{currentTx?.avgSqm ? man1(currentTx.avgSqm * TSUBO) : '—'}</span><span class="kpi-unit">万円/坪</span></div>
                            <div class="kpi-note">㎡単価 <b class="num"><span data-kpi="sqm">{man1(currentTx?.avgSqm)}</span> 万円/㎡</b></div>
                        </div>
                        <div class="card kpi">
                            <div class="kpi-label">
                                <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/></svg></span>
                                前年比騰落率
                            </div>
                            <div class={`kpi-value delta ${dcls(fluctuation)}`} data-kpi="fluc">
                                {fluctuation != null ? (
                                    <>{fluctuation > 0 ? '+' : ''}{fluctuation.toFixed(2)}<span class="kpi-unit">%</span></>
                                ) : '—'}
                            </div>
                            <div class="kpi-note">
                                <span class={`badge ${fluctuation != null ? (fluctuation > 0 ? 'up' : fluctuation < 0 ? 'down' : 'neutral') : 'neutral'}`} data-kpi="flucBadge">
                                    {fluctuation != null ? (fluctuation > 0 ? '▲ 上昇' : fluctuation < 0 ? '▼ 下落' : '横ばい') : 'データなし'}
                                </span>&nbsp;地価公示ベース
                            </div>
                        </div>
                        <div class="card kpi">
                            <div class="kpi-label">
                                <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
                                直近の取引件数
                            </div>
                            <div class="kpi-value"><span data-kpi="count">{fmtInt(currentTx?.count)}</span><span class="kpi-unit">件</span></div>
                            <div class="kpi-note">集計期間 <b>2022年〜最新</b></div>
                        </div>
                    </div>
                </section>

                <!-- 価格推移グラフ & 条件フィルタ -->
                <section class="section" aria-labelledby="trend-title">
                    <div class="grid-chart">
                        <div class="card">
                            <div class="section-head" style="margin-bottom:0;">
                                <div>
                                    <h2 class="card-title" id="trend-title">価格推移と取引件数（四半期別）</h2>
                                    <p class="card-sub">折れ線：平均値 ／ 棒：取引件数。グラフにカーソルを合わせると詳細を表示します。</p>
                                </div>
                                <div class="seg" role="tablist" aria-label="表示指標">
                                    <button type="button" class="seg-btn" role="tab" data-metric="price" aria-selected="true">平均価格</button>
                                    <button type="button" class="seg-btn" role="tab" data-metric="tsubo" aria-selected="false">坪単価</button>
                                </div>
                            </div>
                            <div class="chart-box"><canvas aria-label="価格推移グラフ" role="img"></canvas></div>
                        </div>

                        <aside class="card" aria-labelledby="filter-title">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
                                <h2 class="card-title" id="filter-title" style="margin:0;">条件で絞り込む</h2>
                                <button type="button" class="chip" data-reset style="font-size:0.78rem;">リセット</button>
                            </div>
                            <div class="filters">
                                {(initialType !== 'land' || showMunicipality) && (
                                    <div data-filter-group="age" hidden={initialType === 'land' ? true : undefined}>
                                        <div class="filter-group-label">築年数</div>
                                        <div class="chips">{ageChips.map((c) => <button type="button" class="chip" data-filter={c.filter} data-value={c.value} aria-pressed={String(c.value === '')}>{c.label}</button>)}</div>
                                    </div>
                                )}
                                {(initialType === 'mansion' || showMunicipality) && (
                                    <div data-filter-group="plan" hidden={initialType !== 'mansion' ? true : undefined}>
                                        <div class="filter-group-label">間取り</div>
                                        <div class="chips">{planChips.map((c) => <button type="button" class="chip" data-filter={c.filter} data-value={c.value} aria-pressed={String(c.value === '')}>{c.label}</button>)}</div>
                                    </div>
                                )}
                                <div data-filter-group="area">
                                    <div class="filter-group-label">面積</div>
                                    <div class="chips">{areaChips.map((c) => <button type="button" class="chip" data-filter={c.filter} data-value={c.value} aria-pressed={String(c.value === '')}>{c.label}</button>)}</div>
                                </div>
                                {(initialType === 'house' || showMunicipality) && (
                                    <div data-filter-group="struct" hidden={initialType !== 'house' ? true : undefined}>
                                        <div class="filter-group-label">構造</div>
                                        <div class="chips">{structChips.map((c) => <button type="button" class="chip" data-filter={c.filter} data-value={c.value} aria-pressed={String(c.value === '')}>{c.label}</button>)}</div>
                                    </div>
                                )}
                                <div class="filter-result" data-filter-result aria-live="polite">
                                    該当 <b class="num">{fmtInt(currentTx?.rows?.length || 0)}</b> 件（直近 {fmtInt(currentTx?.rows?.length || 0)} 件中）
                                </div>
                            </div>
                        </aside>
                    </div>
                </section>

                <!-- 直近の取引事例一覧 -->
                <section class="section" aria-labelledby="tx-title">
                    <div class="card">
                        <div class="section-head">
                            <div>
                                <h2 class="card-title" id="tx-title">直近の取引事例一覧（{currentTypeLabel}）</h2>
                                <p class="card-sub">上の絞り込み条件が反映されます。地区名をクリックすると地区別の詳細ページへ移動します。</p>
                            </div>
                            <span class="badge info">国土交通省 不動産情報ライブラリ</span>
                        </div>
                        <div class="table-wrap">
                            <table class="data-table responsive">
                                <thead>
                                    <tr>
                                        <th scope="col">取引時期</th>
                                        <th scope="col">所在地</th>
                                        <th class="r" scope="col">取引価格</th>
                                        <th class="r" scope="col">{isMansion ? '専有面積' : '土地面積'}</th>
                                        <th class="r" scope="col">坪単価</th>
                                        {isMansion ? <th scope="col">間取り</th> : !isLand ? <th class="r" scope="col">延床面積</th> : null}
                                        {!isLand && (
                                            <>
                                                <th class="r" scope="col">建築年</th>
                                                <th scope="col">構造</th>
                                            </>
                                        )}
                                    </tr>
                                </thead>
                                <tbody>
                                    {initialRows.map((r: any) => {
                                        const tsubo = r.pr > 0 && r.a ? (r.pr / r.a) * TSUBO : null;
                                        const loc = showMunicipality ? `${r.pf || ''} ${r.mu || ''}`.trim() : '';
                                        const age = r.by ? `（築${DATA_YEAR - r.by}年）` : '';
                                        return (
                                            <tr>
                                                <td data-label="取引時期" class="num">{r.p}</td>
                                                <td data-label="所在地" class="cell-wide">
                                                    {loc && <><span class="muted">{loc}</span> </>}
                                                    {r.d ? (
                                                        r.dc ? <a href={`/pref${String(r.mc).slice(0, 2)}/${r.mc}/${r.dc}/${initialType}`}>{r.d}</a> : r.d
                                                    ) : <span class="muted">—</span>}
                                                </td>
                                                <td data-label="取引価格" class="r strong num">{r.pr > 0 ? `${manInt(r.pr)} 万円` : '—'}</td>
                                                <td data-label={isMansion ? '専有面積' : '土地面積'} class="r num">{r.a ? `${fmtInt(r.a)} ㎡` : '—'}</td>
                                                <td data-label="坪単価" class="r num">{tsubo ? `${man1(tsubo)} 万円` : '—'}</td>
                                                {isMansion ? (
                                                    <td data-label="間取り">{r.fp || '—'}</td>
                                                ) : !isLand ? (
                                                    <td data-label="延床面積" class="r num">{r.fa ? `${fmtInt(r.fa)} ㎡` : '—'}</td>
                                                ) : null}
                                                {!isLand && (
                                                    <>
                                                        <td data-label="建築年" class="r num">{r.by ? <>{r.by}年<span class="muted">{age}</span></> : '—'}</td>
                                                        <td data-label="構造">{r.st || '—'}</td>
                                                    </>
                                                )}
                                            </tr>
                                        );
                                    })}
                                </tbody>
                            </table>
                            <div class="table-empty" data-table-empty hidden={initialRows.length > 0 ? true : undefined}>条件に一致する取引事例がありません。</div>
                        </div>
                        <div class="table-foot">
                            <span data-table-count class="num">{fmtInt(initialRows.length)} / {fmtInt(currentTx?.rows?.length || 0)} 件を表示</span>
                            <button type="button" class="btn btn-ghost" data-more style="height:38px;" hidden={(currentTx?.rows?.length || 0) <= 20 ? true : undefined}>さらに20件表示</button>
                        </div>
                    </div>
                </section>
            </div>
        </>
    )}

    <!-- ==================== 2. 地価種別ビュー (路線価 / 公示価格 / 基準地価) ==================== -->
    {isLandPriceInitial && (
        <div data-view="land">

            <!-- -------------------- 2-A. 路線価ビュー (/rosenka) -------------------- -->
            {initialType === 'rosenka' && (
                <div data-lp-type="rosenka">
                    <section class="section" aria-labelledby="rosenka-title">
                        <div class="section-head">
                            <div>
                                <h2 class="section-title" id="rosenka-title">{areaName}の路線価（相続税路線価）相場</h2>
                                <p class="section-sub">国税庁が公表する道路（路線）に面する宅地の価格基準（毎年1月1日時点・地価公示の約80%水準）</p>
                            </div>
                            <span class="badge info">国税庁 財産評価基準</span>
                        </div>

                        <div class="kpi-grid">
                            <div class="card kpi">
                                <div class="kpi-label">
                                    <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                                    平均路線価（推計）
                                </div>
                                <div class="kpi-value">{man1(ros.avgPrice)}<span class="kpi-unit">万円/㎡</span></div>
                                <div class="kpi-note">公示価格 × 80% で推計</div>
                            </div>
                            <div class="card kpi">
                                <div class="kpi-label">
                                    <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
                                    平均坪単価（推計）
                                </div>
                                <div class="kpi-value">{man1(ros.avgTsubo)}<span class="kpi-unit">万円/坪</span></div>
                                <div class="kpi-note">1坪 = 3.30578 ㎡</div>
                            </div>
                            <div class="card kpi">
                                <div class="kpi-label">
                                    <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></span>
                                    実勢相場目安（坪単価）
                                </div>
                                <div class="kpi-value">{man1(ros.realMarketEstimateTsubo)}<span class="kpi-unit">万円/坪</span></div>
                                <div class="kpi-note">路線価 ÷ 0.8 × 1.15 倍換算</div>
                            </div>
                            <div class="card kpi">
                                <div class="kpi-label">
                                    <span class="kpi-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
                                    評価水準
                                </div>
                                <div class="kpi-value">約 80<span class="kpi-unit">%</span></div>
                                <div class="kpi-note">地価公示（100%）に対する割合</div>
                            </div>
                        </div>
                    </section>

                    <!-- 用途区分別の路線価相場 -->
                    {ros.divisions && ros.divisions.length > 0 && (
                        <section class="section" aria-labelledby="rosenka-division-title">
                            <div class="card">
                                <div class="section-head" style="margin-bottom:14px;">
                                    <div>
                                        <h3 class="card-title" id="rosenka-division-title">{areaName}の用途区分別 路線価相場</h3>
                                        <p class="card-sub">住宅地・商業地・工業地などの用途区分ごとの平均路線価（㎡単価・坪単価）および調査地点数</p>
                                    </div>
                                    <span class="badge info">{ros.year}年 公示地価×80%推計</span>
                                </div>
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>用途区分</th>
                                                <th class="r">平均路線価（㎡）</th>
                                                <th class="r">平均坪単価</th>
                                                <th class="r">実勢相場目安（坪）</th>
                                                <th class="r">元公示地価（㎡）</th>
                                                <th class="r">前年比変動率</th>
                                                <th class="r">調査地点数</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {ros.divisions.map((d: any) => (
                                                <tr>
                                                    <td class="strong">
                                                        <span class="badge neutral" style="font-size:0.8rem; font-weight:700;">{d.name}</span>
                                                    </td>
                                                    <td class="r strong text-accent">{man1(d.avgPrice)} 万円</td>
                                                    <td class="r num strong">{man1(d.avgTsubo)} 万円</td>
                                                    <td class="r num">{man1(d.realMarketEstimateTsubo)} 万円</td>
                                                    <td class="r num text-muted">{man1(d.officialPrice)} 万円</td>
                                                    <td class={`r delta ${dcls(d.fluctuationRate)}`}>{pct(d.fluctuationRate)}</td>
                                                    <td class="r num">{d.count.toLocaleString()} 地点</td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    )}

                    <!-- 路線価シミュレーション & 4大公的価格比較 -->
                    <section class="section">
                        <div class="grid-2">
                            <div class="card">
                                <h3 class="card-title" style="margin-bottom:12px;">敷地面積別の相続税評価額の目安</h3>
                                <p class="card-sub" style="margin-bottom:16px;">前面道路が平均路線価（{man1(ros.avgPrice)} 万円/㎡）の場合の評価額試算（補正率1.0）</p>
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>敷地規模</th>
                                                <th class="r">面積</th>
                                                <th class="r">相続税評価額の目安</th>
                                            </tr>
                                        </thead>
                                        <tbody>
