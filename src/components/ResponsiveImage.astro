---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
    src: string | ImageMetadata;
    alt: string;
    preset?: 'responsive' | 'hero' | 'card' | 'thumbnail';
    widths?: number[];
    sizes?: string;
    class?: string;
    loading?: 'lazy' | 'eager';
    decoding?: 'async' | 'sync' | 'auto';
    [key: string]: any;
}

const {
    src,
    alt = '',
    preset = 'responsive',
    widths: customWidths,
    sizes: customSizes,
    class: className = '',
    loading = 'lazy',
    decoding = 'async',
    ...rest
} = Astro.props;

// src/assets/images 配下の画像を自動インポート
const allImages = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}',
    { eager: true }
);

let imageMetadata: ImageMetadata | undefined;

if (typeof src === 'string') {
    // フォルダ名・先頭スラッシュを正規化して検索
    const cleanSrc = src.replace(/^\.?\/?(src\/assets\/images\/)?/, '').replace(/^\//, '');
    const matchedPath = Object.keys(allImages).find((path) => {
        return path === src || path.endsWith(`/${cleanSrc}`) || path === `/src/assets/images/${cleanSrc}`;
    });

    if (matchedPath && allImages[matchedPath]) {
        imageMetadata = allImages[matchedPath].default;
    } else {
        console.warn(`[ResponsiveImage] 画像が src/assets/images/ 内に見つかりませんでした: "${src}"`);
    }
} else {
    imageMetadata = src;
}

// プリセット定義（用途に合わせて自動リサイズ＆ブレイクポイント設定）
const PRESETS = {
    // 【PC・スマホ両対応】本文や標準画像（400px, 768px, 1200px を自動生成）
    responsive: {
        widths: [400, 768, 1200],
        sizes: '(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px',
    },
    // 【ヒーロー画像】ファーストビュー・高解像度PC用（640px, 1024px, 1600px を自動生成）
    hero: {
        widths: [640, 1024, 1600],
        sizes: '100vw',
    },
    // 【カード一覧用】市区町村や物件カードなど（320px, 480px, 720px を自動生成）
    card: {
        widths: [320, 480, 720],
        sizes: '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px',
    },
    // 【サムネイル用】小さいアイコンや一覧のミニ画像（160px, 320px を自動生成）
    thumbnail: {
        widths: [160, 320],
        sizes: '160px',
    },
};

const activePreset = PRESETS[preset] || PRESETS.responsive;
const finalWidths = customWidths || activePreset.widths;
const finalSizes = customSizes || activePreset.sizes;
---

{imageMetadata ? (
    <Picture
        src={imageMetadata}
        widths={finalWidths}
        sizes={finalSizes}
        formats={['avif', 'webp']}
        alt={alt}
        class={className}
        loading={loading}
        decoding={decoding}
        {...rest}
    />
) : (
    <!-- 見つからなかった場合のフォールバック表示 -->
    <img
        src={typeof src === 'string' ? src : ''}
        alt={alt}
        class={className}
        loading={loading}
        decoding={decoding}
        {...rest}
    />
)}
