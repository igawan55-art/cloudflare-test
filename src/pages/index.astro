---
import Layout from '../layouts/Layout.astro';
import AreaDashboard from '../components/AreaDashboard.astro';
import { getDb } from '../lib/db.js';
import { getAreaStats, getCityIndex } from '../lib/areaStats.js';
import { getImage } from 'astro:assets';
import bgImage from '../assets/images/background.jpg';
import { buildArticleSchema } from '../lib/structuredData.js';
import { SITE_URL } from '../lib/siteConfig.js';

const desktopBg = await getImage({ src: bgImage, format: 'webp', width: 1920, quality: 82 });
const mobileBg = await getImage({ src: bgImage, format: 'webp', width: 768, quality: 80 });

const db = getDb();
const cities = await getCityIndex(db);
const stats = await getAreaStats(db, { rowLimit: 200 });

const [flucRows] = await db.query(`SELECT AVG(FluctuationRate) AS f FROM appraisals WHERE FluctuationRate IS NOT NULL`);
const fluctuation = flucRows[0]?.f != null ? Number(flucRows[0].f) : null;

// 都道府県（コード順）
const prefMap = new Map();
for (const c of cities) if (!prefMap.has(c.pref)) prefMap.set(c.pref, c.prefName);
const prefectures = [...prefMap.entries()].map(([id, name]) => ({ id, name })).sort((a, b) => a.id.localeCompare(b.id));

// 取引件数の多い人気エリア
const popular = [...cities].sort((a, b) => b.count - a.count).slice(0, 16);
const maxCount = popular[0]?.count || 1;

const totalCount = Object.values(stats.types).reduce((s, t: any) => s + t.count, 0);
const cityOptions = JSON.stringify(cities.map((c) => [c.pref, c.code, c.name])).replace(/</g, '\\u003c');

const pageTitle = "公的データでわかる不動産相場｜チカシル（国土交通省 不動産情報ライブラリ）";
const pageDesc = "国土交通省「不動産情報ライブラリ」の公的データをもとに、全国の不動産取引価格・路線価・公示地価をわかりやすく可視化する相場検索サイトです。";

const canonicalUrl = `${SITE_URL}/`;
const articleSchema = buildArticleSchema({
    title: pageTitle,
    headline: "不動産の取引価格、路線価、公示価格、地価を知る - チカシル",
    description: pageDesc,
    url: canonicalUrl
});
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl} jsonLd={articleSchema}>
    <style define:vars={{ desktopBg: `url('${desktopBg.src}')`, mobileBg: `url('${mobileBg.src}')` }}>
        .hero {
            background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(248, 250, 252, 0.82) 100%), var(--desktopBg);
        }
        @media (max-width: 768px) {
            .hero {
                background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(248, 250, 252, 0.82) 100%), var(--mobileBg);
            }
        }
    </style>

    <!-- 2. ヒーロー & エリア検索 -->
    <section class="hero" id="search">
        <div class="container hero-grid">
            <div>
                <span class="eyebrow">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    国土交通省 不動産情報ライブラリ 準拠
                </span>
                <h1>公的データでわかる、<br>納得の不動産相場</h1>
                <p class="hero-lead">
                    全国 <b class="num">{cities.length.toLocaleString()}</b> 市区町村・<b class="num">{totalCount.toLocaleString()}</b> 件の実際の取引価格をもとに、エリアごとの平均価格・坪単価・価格推移をわかりやすく可視化しています。
                </p>
                <ul class="hero-points">
                    <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>実際の成約・取引データ</li>
                    <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>地価公示と比較</li>
                    <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>会員登録不要・無料</li>
                </ul>
            </div>

            <form class="card card-lg" id="area-search" aria-labelledby="search-title" style="box-shadow: var(--shadow-md);">
                <h2 class="card-title" id="search-title" style="font-size:1.15rem;">エリアから相場を調べる</h2>
                <p class="card-sub" style="margin-bottom:20px;">都道府県・市区町村・町名を選択してください</p>

                <div class="stack">
                    <div class="field">
                        <label for="pref-select">物件種別</label>
                        <div class="seg seg-full" role="tablist" aria-label="物件種別">
                            <button type="button" class="seg-btn" role="tab" data-search-type="mansion" aria-selected="true">中古マンション</button>
                            <button type="button" class="seg-btn" role="tab" data-search-type="house" aria-selected="false">戸建て</button>
                            <button type="button" class="seg-btn" role="tab" data-search-type="land" aria-selected="false">土地</button>
                        </div>
                    </div>
                    <div class="grid-2">
                        <div class="field">
                            <label for="pref-select">都道府県</label>
                            <select id="pref-select" class="select" required>
                                <option value="">選択してください</option>
                                {prefectures.map((p) => <option value={p.id}>{p.name}</option>)}
                            </select>
                        </div>
                        <div class="field">
                            <label for="city-select">市区町村</label>
                            <select id="city-select" class="select" disabled required>
                                <option value="">先に都道府県を選択</option>
                            </select>
                        </div>
                    </div>
                    <div class="field">
                        <label for="district-select">町名・地区（任意）</label>
                        <select id="district-select" class="select" disabled>
                            <option value="">先に市区町村を選択</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" id="search-btn" disabled>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                        この条件で相場を見る
                    </button>
                </div>
            </form>
        </div>
    </section>

    <div class="container">
        <AreaDashboard areaName="全国" stats={stats} fluctuation={fluctuation} showMunicipality={true} />

        <!-- 人気エリア -->
        <section class="section" id="popular" aria-labelledby="popular-title">
            <div class="section-head">
                <div>
                    <h2 class="section-title" id="popular-title">取引件数の多いエリア</h2>
                    <p class="section-sub">取引件数上位の市区町村</p>
                </div>
            </div>
            <div class="grid-2" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
                {popular.map((c, i) => (
                    <a href={`/${c.pref}/${c.code}`} class="card" style="display:flex; align-items:center; gap:16px; padding:18px 20px; color:inherit; text-decoration:none;">
                        <span class="num" style="width:28px; font-weight:700; color:var(--subtle);">{String(i + 1).padStart(2, '0')}</span>
                        <span style="flex:1; min-width:0;">
                            <span style="display:block; font-size:0.75rem; color:var(--muted);">{c.prefName}</span>
                            <span style="display:block; font-weight:700;">{c.name}</span>
                            <span class="mini-bar" style="display:block; margin-top:8px;"><i style={`width:${Math.round(c.count / maxCount * 100)}%`}></i></span>
                        </span>
                        <span class="num" style="font-weight:700; color:var(--primary); white-space:nowrap;">{c.count.toLocaleString()}<span style="font-size:0.75rem; color:var(--muted); font-weight:500;"> 件</span></span>
                    </a>
                ))}
            </div>
        </section>

        <section class="section">
            <div class="callout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                <div>
                    掲載データは国土交通省「不動産情報ライブラリ」で公開されている不動産取引価格情報です。個人が特定されないよう所在地は地区単位までとなっており、最寄駅などの情報は含まれません。集計方法の詳細はページ下部の「データの出典と集計方法」をご確認ください。
                </div>
            </div>
        </section>
    </div>
</Layout>

<script is:inline define:vars={{ cityOptions }}>
    const cityList = JSON.parse(cityOptions);
    const prefSel = document.getElementById('pref-select');
    const citySel = document.getElementById('city-select');
    const distSel = document.getElementById('district-select');
    const btn = document.getElementById('search-btn');
    const validTypes = ['mansion', 'house', 'land'];
    const initialUrlType = new URLSearchParams(location.search).get('type');
    let searchType = validTypes.includes(initialUrlType) ? initialUrlType : 'mansion';

    function syncSearchTabs(type) {
        searchType = type;
        document.querySelectorAll('[data-search-type]').forEach((x) => {
            x.setAttribute('aria-selected', String(x.dataset.searchType === type));
        });
    }
    syncSearchTabs(searchType);

    document.querySelectorAll('[data-search-type]').forEach((b) => {
        b.addEventListener('click', () => {
            const nextType = b.dataset.searchType;
            syncSearchTabs(nextType);
            // 下部のダッシュボードタブとも連動（URLの ?type= も dashboard.js 側で更新される）
            const dashTab = document.querySelector(`[data-type-tab="${nextType}"]`);
            if (dashTab && dashTab.getAttribute('aria-selected') !== 'true') {
                dashTab.click();
            } else {
                const url = new URL(location.href);
                url.searchParams.set('type', nextType);
                history.pushState({ type: nextType }, '', url);
            }
        });
    });

    window.addEventListener('dashboard:typechange', (e) => {
        if (e.detail && e.detail.type) syncSearchTabs(e.detail.type);
    });

    prefSel.addEventListener('change', () => {
        const items = cityList.filter((c) => c[0] === prefSel.value);
        citySel.innerHTML = items.length
            ? '<option value="">選択してください</option>' + items.map((c) => `<option value="${c[1]}">${c[2]}</option>`).join('')
            : '<option value="">先に都道府県を選択</option>';
        citySel.disabled = !items.length;
        distSel.innerHTML = '<option value="">先に市区町村を選択</option>';
        distSel.disabled = true;
        btn.disabled = true;
    });

    citySel.addEventListener('change', async () => {
        const code = citySel.value;
        btn.disabled = !code;
        if (!code) {
            distSel.innerHTML = '<option value="">先に市区町村を選択</option>';
            distSel.disabled = true;
            return;
        }
        const cityName = citySel.options[citySel.selectedIndex]?.text || '市区町村';
        distSel.innerHTML = `<option value="">読み込み中...</option>`;
        distSel.disabled = true;
        try {
            const res = await fetch(`/api/districts/${code}.json`);
            const districts = res.ok ? await res.json() : [];
            distSel.innerHTML =
                `<option value="">すべて（${cityName}全体）</option>` +
                districts.map((d) => `<option value="${d.code}">${d.name}</option>`).join('');
            distSel.disabled = false;
        } catch {
            distSel.innerHTML = `<option value="">すべて（${cityName}全体）</option>`;
            distSel.disabled = false;
        }
    });

    document.getElementById('area-search').addEventListener('submit', (e) => {
        e.preventDefault();
        if (!prefSel.value || !citySel.value) return;
        const basePath = distSel.value
            ? `/${prefSel.value}/${citySel.value}/${distSel.value}`
            : `/${prefSel.value}/${citySel.value}`;
        location.href = `${basePath}?type=${encodeURIComponent(searchType)}`;
    });
</script>

