---
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/db.js';
import { getCityIndex } from '../../lib/areaStats.js';
import { buildBreadcrumbSchema, buildArticleSchema } from '../../lib/structuredData.js';
import { SITE_URL } from '../../lib/siteConfig.js';

const db = getDb();
const cities = await getCityIndex(db);

const PREFECTURE_NAMES: Record<string, string> = {
    '01': '北海道', '02': '青森県', '03': '岩手県', '04': '宮城県', '05': '秋田県',
    '06': '山形県', '07': '福島県', '08': '茨城県', '09': '栃木県', '10': '群馬県',
    '11': '埼玉県', '12': '千葉県', '13': '東京都', '14': '神奈川県', '15': '新潟県',
    '16': '富山県', '17': '石川県', '18': '福井県', '19': '山梨県', '20': '長野県',
    '21': '岐阜県', '22': '静岡県', '23': '愛知県', '24': '三重県', '25': '滋賀県',
    '26': '京都府', '27': '大阪府', '28': '兵庫県', '29': '奈良県', '30': '和歌山県',
    '31': '鳥取県', '32': '島根県', '33': '岡山県', '34': '広島県', '35': '山口県',
    '36': '徳島県', '37': '香川県', '38': '愛媛県', '39': '高知県', '40': '福岡県',
    '41': '佐賀県', '42': '長崎県', '43': '熊本県', '44': '大分県', '45': '宮崎県',
    '46': '鹿児島県', '47': '沖縄県'
};

const REGIONS = [
    { name: '北海道', codes: ['01'] },
    { name: '東北', codes: ['02', '03', '04', '05', '06', '07'] },
    { name: '関東', codes: ['08', '09', '10', '11', '12', '13', '14'] },
    { name: '中部', codes: ['15', '16', '17', '18', '19', '20', '21', '22', '23'] },
    { name: '近畿', codes: ['24', '25', '26', '27', '28', '29', '30'] },
    { name: '中国', codes: ['31', '32', '33', '34', '35'] },
    { name: '四国', codes: ['36', '37', '38', '39'] },
    { name: '九州・沖縄', codes: ['40', '41', '42', '43', '44', '45', '46', '47'] },
];

// 都道府県ごとに市区町村をグループ化
const prefMap = new Map<string, { id: string; slug: string; name: string; count: number; cities: Array<{ code: string; name: string; count: number }> }>();

for (const [id, name] of Object.entries(PREFECTURE_NAMES)) {
    prefMap.set(id, {
        id,
        slug: `pref${id}`,
        name,
        count: 0,
        cities: []
    });
}

for (const c of cities) {
    const prefId = c.code.slice(0, 2);
    const target = prefMap.get(prefId);
    if (target) {
        target.count += c.count;
        target.cities.push({
            code: c.code,
            name: c.name,
            count: c.count
        });
    }
}

// クライアント側でモーダルが即時利用できるようにJSON化
const prefDataJson = JSON.stringify(Object.fromEntries(prefMap)).replace(/</g, '\\u003c');

const pageTitle = "全国の不動産相場 エリア一覧｜都道府県・市区町村・町字から探す";
const pageDesc = "全国47都道府県の不動産相場（中古マンション・戸建て・土地）のエリア一覧。都道府県を選択すると市区町村および配下の町字一覧から詳細な相場情報をご覧いただけます。";

const breadcrumbs = buildBreadcrumbSchema([
    { name: 'トップ', url: '/' },
    { name: 'エリア一覧', url: '/areas' }
]);

const canonicalUrl = `${SITE_URL}/areas`;
const articleSchema = buildArticleSchema({
    title: pageTitle,
    headline: "全国47都道府県の不動産相場・地価エリア一覧",
    description: pageDesc,
    url: canonicalUrl
});
---

<Layout
    title={pageTitle}
    description={pageDesc}
    canonical={canonicalUrl}
    jsonLd={[breadcrumbs, articleSchema]}
>
    <section class="page-head">
        <div class="container">
            <nav class="breadcrumb" aria-label="パンくずリスト">
                <a href="/">トップ</a><span class="sep">/</span>
                <span aria-current="page">エリア一覧</span>
            </nav>
            <span class="eyebrow">全国 47都道府県</span>
            <h1 class="page-title" style="margin-top:10px;">エリアから相場を探す</h1>
            <p style="color:var(--muted); font-size:0.95rem; margin-top:8px;">
                都道府県を選択すると、市区町村と配下の町字（町名）別の相場情報をご覧いただけます。
            </p>
        </div>
    </section>

    <div class="container" style="padding-top: 32px; padding-bottom: 64px;">
        <div class="regions-list">
            {REGIONS.map((reg) => (
                <section class="region-section">
                    <h2 class="region-title">{reg.name}</h2>
                    <div class="pref-grid">
                        {reg.codes.map((code) => {
                            const p = prefMap.get(code)!;
                            return (
                                <button
                                    type="button"
                                    class="pref-card"
                                    data-open-modal={p.slug}
                                    data-pref-id={p.id}
                                    aria-haspopup="dialog"
                                >
                                    <span class="pref-name">{p.name}</span>
                                    <span class="pref-meta">
                                        <span>{p.cities.length} 市区町村</span>
                                        <span class="pref-count">{p.count.toLocaleString()} 件</span>
                                    </span>
                                    <svg class="pref-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                                </button>
                            );
                        })}
                    </div>
                </section>
            ))}
        </div>
    </div>

    <!-- 市区町村・町字表示モーダル -->
    <div id="area-modal" class="modal-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-card">
            <!-- モーダルヘッダー -->
            <div class="modal-header">
                <div>
                    <nav id="modal-breadcrumb" class="modal-breadcrumb">
                        <span id="modal-crumb-pref" class="crumb-active">東京都</span>
                        <span id="modal-crumb-sep" class="sep" hidden>/</span>
                        <span id="modal-crumb-city" class="crumb-sub" hidden>港区</span>
                    </nav>
                    <div style="display:flex; align-items:center; gap:12px; margin-top:2px; flex-wrap:wrap;">
                        <h3 id="modal-title" class="modal-title" style="margin:0;">東京都の市区町村一覧</h3>
                        <a id="modal-pref-page-link" href="#" class="btn-sm" style="font-size:0.75rem; font-weight:600; padding:3px 10px; background:var(--primary-50, #eff6ff); color:var(--primary); border:1px solid var(--border); border-radius:4px; text-decoration:none;">
                            都道府県サマリーを見る &rarr;
                        </a>
                    </div>
                </div>
                <button type="button" id="modal-close-btn" class="modal-close" aria-label="閉じる">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- モーダル本体コンテンツ -->
            <div class="modal-body">
                <!-- ステップ1: 市区町村一覧ビュー -->
                <div id="view-cities" class="view-panel">
                    <div id="cities-list" class="city-grid"></div>
                    <div id="cities-empty" class="empty-msg" hidden>該当する市区町村がありません</div>
                </div>

                <!-- ステップ2: 配下の町字一覧ビュー -->
                <div id="view-districts" class="view-panel" hidden>
                    <div class="district-nav-bar">
                        <button type="button" id="back-to-cities-btn" class="btn btn-ghost btn-sm">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                            市区町村一覧に戻る
                        </button>
                        <a id="city-page-link" href="#" class="city-page-link">
                            <span id="city-page-link-text">港区全体の相場を見る</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                    <div id="districts-loading" class="loading-state">
                        <div class="spinner"></div>
                        <p>町字データを読み込み中...</p>
                    </div>
                    <div id="districts-list" class="district-grid" hidden></div>
                    <div id="districts-empty" class="empty-msg" hidden>登録されている町字がありません</div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .regions-list {
        display: flex;
        flex-direction: column;
        gap: 36px;
    }
    .region-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px 28px;
        box-shadow: var(--shadow-sm);
    }
    .region-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-50);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .region-title::before {
        content: '';
        width: 4px;
        height: 18px;
        background: var(--accent);
        border-radius: 2px;
    }
    .pref-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
    }
    .pref-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 16px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        cursor: pointer;
        text-align: left;
        transition: all 0.15s ease-in-out;
        color: var(--text);
    }
    .pref-card:hover {
        border-color: var(--accent);
        box-shadow: var(--shadow-md);
        transform: translateY(-1px);
        background: var(--accent-50);
    }
    .pref-name {
        font-weight: 700;
        font-size: 0.98rem;
    }
    .pref-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font-size: 0.76rem;
        color: var(--muted);
        line-height: 1.35;
    }
    .pref-count {
        font-weight: 600;
        color: var(--primary);
    }
    .pref-arrow {
        color: var(--subtle);
        flex-shrink: 0;
        transition: transform 0.15s ease;
    }
    .pref-card:hover .pref-arrow {
        color: var(--accent);
        transform: translateX(2px);
    }

    /* モーダル */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 1000;
        display: grid;
        place-items: center;
        padding: 20px;
        animation: fadeIn 0.18s ease-out;
    }
    .modal-overlay[hidden] {
        display: none !important;
    }
    .modal-card {
        background: #fff;
        border-radius: var(--radius);
        width: 100%;
        max-width: 860px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        animation: scaleUp 0.18s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @keyframes scaleUp {
        from { transform: scale(0.96); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        background: #F8FAFC;
    }
    .modal-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: var(--muted);
        margin-bottom: 4px;
    }
    .modal-breadcrumb .sep { color: var(--subtle); }
    .modal-breadcrumb .crumb-active { color: var(--accent); font-weight: 600; cursor: pointer; }
    .modal-breadcrumb .crumb-active:hover { text-decoration: underline; }
    .modal-breadcrumb .crumb-sub { color: var(--text); font-weight: 600; }

    .modal-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        margin: 0;
    }
    .modal-close {
        background: transparent;
        border: 0;
        color: var(--muted);
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }
    .modal-close:hover {
        background: #E2E8F0;
        color: var(--text);
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        flex: 1;
        background: #fff;
    }

    /* 市区町村一覧 */
    .city-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 10px;
    }
    .city-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 12px 14px;
        background: #F8FAFC;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-decoration: none;
        color: var(--text);
        transition: all 0.15s;
    }
    .city-card:hover {
        background: #fff;
        border-color: var(--accent);
        box-shadow: var(--shadow-sm);
        color: var(--accent);
        text-decoration: none;
        transform: translateY(-1px);
    }
    .city-card-name {
        font-weight: 600;
        font-size: 0.92rem;
        line-height: 1.35;
    }
    .city-card-count {
        font-size: 0.74rem;
        color: var(--muted);
        margin-top: 4px;
    }

    /* 町字ビュー */
    .district-nav-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 12px;
    }
    .btn-sm {
        height: 36px;
        padding: 0 14px;
        font-size: 0.85rem;
        gap: 6px;
    }
    .city-page-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--accent);
    }
    .city-page-link:hover { text-decoration: underline; }

    .district-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 10px;
    }
    .district-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 12px 14px;
        background: #F8FAFC;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        text-decoration: none;
        color: var(--text);
        transition: all 0.15s;
    }
    .district-card:hover {
        background: #fff;
        border-color: var(--accent);
        box-shadow: var(--shadow-sm);
        color: var(--accent);
        text-decoration: none;
        transform: translateY(-1px);
    }
    .district-name {
        font-weight: 600;
        font-size: 0.92rem;
        line-height: 1.35;
    }
    .district-count {
        font-size: 0.74rem;
        color: var(--muted);
        margin-top: 4px;
    }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 0;
        color: var(--muted);
        gap: 12px;
    }
    .loading-state[hidden],
    .view-panel[hidden],
    .empty-msg[hidden],
    .district-grid[hidden],
    .modal-overlay[hidden] {
        display: none !important;
    }
    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    .empty-msg {
        text-align: center;
        color: var(--muted);
        padding: 40px 0;
        font-size: 0.9rem;
    }

    @media (max-width: 640px) {
        .pref-grid { grid-template-columns: 1fr 1fr; }
        .city-grid { grid-template-columns: 1fr; }
        .district-grid { grid-template-columns: 1fr 1fr; }
        .modal-card { max-height: 92vh; }
    }
</style>

<script is:inline define:vars={{ prefDataJson }}>
    const prefData = JSON.parse(prefDataJson);
    const modal = document.getElementById('area-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const modalTitle = document.getElementById('modal-title');
    const crumbPref = document.getElementById('modal-crumb-pref');
    const crumbSep = document.getElementById('modal-crumb-sep');
    const crumbCity = document.getElementById('modal-crumb-city');

    const viewCities = document.getElementById('view-cities');
    const viewDistricts = document.getElementById('view-districts');
    const citiesList = document.getElementById('cities-list');
    const citiesEmpty = document.getElementById('cities-empty');
    const districtsList = document.getElementById('districts-list');
    const districtsLoading = document.getElementById('districts-loading');
    const districtsEmpty = document.getElementById('districts-empty');
    const backBtn = document.getElementById('back-to-cities-btn');
    const cityPageLink = document.getElementById('city-page-link');
    const cityPageLinkText = document.getElementById('city-page-link-text');
    const modalPrefPageLink = document.getElementById('modal-pref-page-link');

    let currentPref = null;
    let currentCity = null;
    let currentDistrictsCache = new Map(); // cityCode -> districts[]

    function getSelectedType() {
        return new URLSearchParams(location.search).get('type') || '';
    }

    function appendType(url) {
        const type = getSelectedType();
        if (!type) return url;
        const u = new URL(url, location.origin);
        u.searchParams.set('type', type);
        return u.pathname + u.search + u.hash;
    }

    function openPrefecture(prefId) {
        const data = prefData[prefId];
        if (!data) return;
        currentPref = data;
        currentCity = null;

        // モーダルヘッダー初期化
        crumbPref.textContent = data.name;
        crumbSep.hidden = true;
        crumbCity.hidden = true;
        modalTitle.textContent = `${data.name} の市区町村一覧（${data.cities.length}）`;
        if (modalPrefPageLink) {
            modalPrefPageLink.href = `/${data.slug}/`;
            modalPrefPageLink.textContent = `${data.name}の相場・地価サマリーを見る →`;
        }

        // ビュー切り替え
        viewCities.hidden = false;
        viewDistricts.hidden = true;

        renderCities(data.cities);

        modal.hidden = false;
        document.body.style.overflow = 'hidden';
    }

    function renderCities(cityList) {
        citiesList.innerHTML = '';
        if (!cityList.length) {
            citiesEmpty.hidden = false;
            return;
        }
        citiesEmpty.hidden = true;

        cityList.forEach((c) => {
            const a = document.createElement('a');
            a.className = 'city-card';
            a.href = appendType(`/${currentPref.slug}/${c.code}`);
            a.innerHTML = `
                <span class="city-card-name">${c.name}</span>
                <span class="city-card-count">${(c.count || 0).toLocaleString()} 件</span>
            `;
            a.addEventListener('click', (e) => {
                // Ctrl / Cmd / Shift クリックや中クリック時は新規タブ等で通常遷移させる
                if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) {
                    return;
                }
                e.preventDefault();
                openDistricts(c);
            });
            citiesList.appendChild(a);
        });
    }

    async function openDistricts(city) {
        currentCity = city;
        const prefSlug = currentPref.slug;

        crumbSep.hidden = false;
        crumbCity.hidden = false;
        crumbCity.textContent = city.name;
        modalTitle.textContent = `${currentPref.name}${city.name} の町字一覧`;

        viewCities.hidden = true;
        viewDistricts.hidden = false;

        cityPageLink.href = appendType(`/${prefSlug}/${city.code}`);
        cityPageLinkText.textContent = `${city.name} 全体の相場を見る`;

        districtsList.innerHTML = '';
        districtsList.hidden = true;
        districtsEmpty.hidden = true;
        districtsLoading.hidden = false;

        try {
            let districts = currentDistrictsCache.get(city.code);
            if (!districts) {
                const res = await fetch(`/api/districts/${city.code}.json`);
                districts = res.ok ? await res.json() : [];
                currentDistrictsCache.set(city.code, districts);
            }
            districtsLoading.hidden = true;
            modalTitle.textContent = `${currentPref.name}${city.name} の町字一覧（${districts.length}）`;
            renderDistricts(districts);
        } catch (err) {
            console.error('[areas] 町字データの読み込みエラー:', err);
            districtsLoading.hidden = true;
            districtsEmpty.hidden = false;
        }
    }

    function renderDistricts(districtList) {
        districtsList.innerHTML = '';
        if (!districtList || !districtList.length) {
            districtsEmpty.hidden = false;
            districtsList.hidden = true;
            return;
        }
        districtsEmpty.hidden = true;
        districtsList.hidden = false;

        districtList.forEach((d) => {
            const a = document.createElement('a');
            a.className = 'district-card';
            a.href = appendType(`/${currentPref.slug}/${currentCity.code}/${d.code}`);
            a.innerHTML = `
                <span class="district-name">${d.name}</span>
                <span class="district-count">${(d.count || 0).toLocaleString()} 件</span>
            `;
            districtsList.appendChild(a);
        });
    }

    function backToCities() {
        if (!currentPref) return;
        currentCity = null;
        crumbSep.hidden = true;
        crumbCity.hidden = true;
        modalTitle.textContent = `${currentPref.name} の市区町村一覧（${currentPref.cities.length}）`;
        viewCities.hidden = false;
        viewDistricts.hidden = true;
        renderCities(currentPref.cities);
    }

    function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = '';
    }

    // パンくずの都道府県クリックで市区町村へ戻る
    crumbPref.addEventListener('click', backToCities);
    backBtn.addEventListener('click', backToCities);

    // 都道府県カードクリック
    document.querySelectorAll('[data-open-modal]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const prefId = btn.dataset.prefId;
            openPrefecture(prefId);
        });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    // URLハッシュ（例: /areas#pref13）で直接特定都道府県のモーダルを開く
    const hash = location.hash.replace('#', '');
    if (hash.startsWith('pref')) {
        const id = hash.replace('pref', '');
        if (prefData[id]) openPrefecture(id);
    }
</script>
