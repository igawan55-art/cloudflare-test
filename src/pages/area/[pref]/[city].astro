---
import Layout from '../../../layouts/Layout.astro';
import { getDb } from '../../../lib/db.js';

export async function getStaticPaths() {
    const db = getDb();
    const [rows] = await db.query(`
        SELECT DISTINCT Prefecture, Municipality 
        FROM transactions
    `);
    
    return rows.map(row => ({
        params: {
            pref: row.Prefecture,
            city: row.Municipality
        }
    }));
}

const { pref, city } = Astro.params;

const db = getDb();
const [txRows] = await db.query(`
    SELECT Type as type, Period as period, FloorPlan as floorPlan, 
           Area as area, BuildingYear as buildingYear, TradePrice as price 
    FROM transactions 
    WHERE Prefecture = ? AND Municipality = ?
    ORDER BY Period DESC
`, [pref, city]);

const cityTransactions = txRows.map(tx => ({
    ...tx,
    price: tx.price ? parseInt(tx.price) : 0
}));

// 市区町村全体の鑑定評価書データ（公示価格、変動率、利回りなど）を取得
const [cityAppraisalRows] = await db.query(`
    SELECT AVG(OfficialPrice) as avgOfficial, 
           AVG(PricePerSqm) as avgPricePerSqm,
           AVG(FluctuationRate) as avgFluctuation,
           AVG(CASE WHEN CapRate > 0 THEN CapRate ELSE NULL END) as avgCapRate
    FROM appraisals 
    WHERE Prefecture = ? AND MunicipalityCode = (
        SELECT MunicipalityCode FROM transactions WHERE Municipality = ? LIMIT 1
    )
`, [pref, city]);

const appraisalData = cityAppraisalRows[0] || {};
---

<Layout title={`${city} 全体の不動産価格相場 - RealEstate Analytics`}>
    <div class="container area-detail-page">
        <nav class="breadcrumb">
            <a href="/">トップ</a> &gt; 
            <span>{pref}</span> &gt; 
            <span>{city}</span>
        </nav>

        <section class="area-header" style="margin-bottom: 30px;">
            <h2>{city} 全体の不動産価格相場</h2>
            <p>{pref} {city} のエリア基本情報や実勢相場、公的価格（公示地価・路線価）を比較確認できます。</p>
        </section>
        
        <div class="tabs" style="display:flex; gap:10px; margin-bottom:20px; border-bottom: 2px solid #ddd; padding-bottom: 5px;">
            <button class="btn tab-btn active" data-type="mansion" style="border:none; background:transparent; font-size:1.1rem; font-weight:bold; cursor:pointer; color:var(--primary-color);">中古マンション</button>
            <button class="btn tab-btn" data-type="house" style="border:none; background:transparent; font-size:1.1rem; cursor:pointer; color:#555;">戸建て</button>
            <button class="btn tab-btn" data-type="land" style="border:none; background:transparent; font-size:1.1rem; cursor:pointer; color:#555;">土地</button>
        </div>

        <!-- 3x2 Grid for Transaction vs Official Prices -->
        <section class="summary-section" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:15px; margin-bottom:25px;">
            <!-- 実勢価格ブロック -->
            <div class="summary-card" style="background:#fff; padding:18px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05); border-left: 4px solid var(--primary-color);">
                <div style="font-size:0.85rem; color:#666;">市場実勢相場</div>
                <h4 style="margin: 5px 0;">平均取引価格</h4>
                <p id="avg-price" style="font-size:1.8rem; font-weight:bold; color:var(--primary-color); margin:5px 0;">-- 万円</p>
                <span id="price-sub" style="font-size:0.8rem; color:#888;">直近の取引実績より算出</span>
            </div>

            <div class="summary-card" style="background:#fff; padding:18px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05); border-left: 4px solid #28a745;">
                <div style="font-size:0.85rem; color:#666;">取引単価</div>
                <h4 id="label-unit-price" style="margin: 5px 0;">平均㎡単価</h4>
                <p id="unit-price" style="font-size:1.8rem; font-weight:bold; color:#28a745; margin:5px 0;">-- 万円/㎡</p>
                <span id="label-tsubo-price" style="font-size:0.85rem; font-weight:bold; color:#555;">坪単価: -- 万円/坪</span>
            </div>

            <!-- 公的価格ブロック（鑑定データ連携） -->
            <div class="summary-card" style="background:#fff; padding:18px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05); border-left: 4px solid #17a2b8;">
                <div style="font-size:0.85rem; color:#666;">公的指標（国交省鑑定評価）</div>
                <h4 style="margin: 5px 0;">公示地価 (基準価格)</h4>
                <p id="official-price" style="font-size:1.8rem; font-weight:bold; color:#17a2b8; margin:5px 0;">-- 万円/㎡</p>
                <span id="official-tsubo" style="font-size:0.85rem; font-weight:bold; color:#555;">公示坪単価: -- 万円/坪</span>
            </div>

            <div class="summary-card" style="background:#fff; padding:18px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05); border-left: 4px solid #6f42c1;">
                <div style="font-size:0.85rem; color:#666;">相続税評価の目安</div>
                <h4 style="margin: 5px 0;">路線価の目安</h4>
                <p id="road-price" style="font-size:1.8rem; font-weight:bold; color:#6f42c1; margin:5px 0;">-- 万円/㎡</p>
                <span id="road-tsubo" style="font-size:0.85rem; font-weight:bold; color:#555;">路線価坪単価: -- 万円/坪</span>
            </div>
        </section>

        <!-- 分析・加工データバナー -->
        <section class="analysis-banner" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border: 1px solid #ced4da; padding: 20px; border-radius: 8px; margin-bottom: 30px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-around; align-items: center;">
            <div style="text-align: center;">
                <div style="font-size:0.85rem; color:#666; font-weight:bold;">市場乖離判定 (実勢 vs 公示)</div>
                <div id="market-divergence" style="font-size:1.25rem; font-weight:bold; color:#333; margin-top:5px;">判定中...</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size:0.85rem; color:#666; font-weight:bold;">地価変動率 (前年比)</div>
                <div id="price-fluctuation" style="font-size:1.25rem; font-weight:bold; color:#28a745; margin-top:5px;">-- %</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size:0.85rem; color:#666; font-weight:bold;">期待還元利回り (キャップレート)</div>
                <div id="cap-rate" style="font-size:1.25rem; font-weight:bold; color:#fd7e14; margin-top:5px;">-- %</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size:0.85rem; color:#666; font-weight:bold;">対象取引データ件数</div>
                <div id="trade-count" style="font-size:1.25rem; font-weight:bold; color:#0056b3; margin-top:5px;">-- 件</div>
            </div>
        </section>

        <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-bottom:30px;">
            <section class="chart-section" style="flex:2; min-width:400px; background:#fff; padding:20px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05);">
                <h3>価格推移 (過去5年)</h3>
                <div style="height:300px;"><canvas id="priceTrendChart"></canvas></div>
            </section>
            <section class="chart-section" style="flex:1; min-width:300px; background:#fff; padding:20px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05);">
                <h3>価格帯別 取引件数</h3>
                <div style="height:300px;"><canvas id="distributionChart"></canvas></div>
            </section>
        </div>
    </div>
</Layout>

<script is:inline src="/assets/js/chart.js"></script>
<script is:inline define:vars={{ cityTransactions, appraisalData }}>
    document.addEventListener('DOMContentLoaded', () => {
        const trendCanvas = document.getElementById('priceTrendChart');
        const distCanvas = document.getElementById('distributionChart');

        const officialNum = appraisalData && appraisalData.avgOfficial ? parseFloat(appraisalData.avgOfficial) : null;
        const fluctuationNum = appraisalData && appraisalData.avgFluctuation ? parseFloat(appraisalData.avgFluctuation) : null;
        const capRateNum = appraisalData && appraisalData.avgCapRate ? parseFloat(appraisalData.avgCapRate) : null;

        const getMockData = (type) => {
            let base = type === 'house' ? 1.5 : (type === 'land' ? 0.8 : 1);
            return {
                trend: {
                    labels: ['2019', '2020', '2021', '2022', '2023', '2024'],
                    prices: [3800*base, 3950*base, 4100*base, 4300*base, 4450*base, 4500*base],
                    counts: [150, 140, 160, 130, 125, 124]
                },
                dist: {
                    labels: ['~3000万', '3000万~4000万', '4000万~5000万', '5000万~6000万', '6000万~'],
                    counts: [Math.floor(Math.random()*20+5), Math.floor(Math.random()*30+20), Math.floor(Math.random()*40+20), Math.floor(Math.random()*20+10), Math.floor(Math.random()*10+5)]
                }
            };
        };

        const loadCharts = (type) => {
            const data = getMockData(type);
            if (trendCanvas) window.ChartManager.drawTrendChart(trendCanvas.getContext('2d'), data.trend);
            if (distCanvas) window.ChartManager.drawDistributionChart(distCanvas.getContext('2d'), data.dist);

            const areaLabel = type === 'mansion' ? '(専有面積)' : '(土地面積)';
            document.querySelector('#label-unit-price').textContent = `平均㎡単価 ${areaLabel}`;

            let targetType = type === 'mansion' ? '中古マンション等' : (type === 'house' ? '宅地(土地と建物)' : '宅地(土地)');
            
            const filteredTxs = cityTransactions.filter(tx => tx.type === targetType);
            const validPrices = filteredTxs.filter(tx => tx.price > 0);

            let avgPriceMan = 0;
            let avgUnitPriceMan = 0;
            let avgTsuboPriceMan = 0;

            if (validPrices.length > 0) {
                const sumPrice = validPrices.reduce((sum, tx) => sum + tx.price, 0);
                avgPriceMan = Math.round(sumPrice / validPrices.length / 10000);
                
                const validAreaTxs = validPrices.filter(tx => parseFloat(tx.area) > 0);
                if (validAreaTxs.length > 0) {
                    const sumUnitPrice = validAreaTxs.reduce((sum, tx) => sum + (tx.price / parseFloat(tx.area)), 0);
                    avgUnitPriceMan = Math.round(sumUnitPrice / validAreaTxs.length / 10000);
                } else {
                    avgUnitPriceMan = Math.round(avgPriceMan / (type === 'mansion' ? 60 : 100));
                }
                avgTsuboPriceMan = Math.round(avgUnitPriceMan * 3.30578);
            } else {
                avgPriceMan = type === 'house' ? 6500 : (type === 'land' ? 4200 : 5400);
                avgUnitPriceMan = Math.round(avgPriceMan / (type === 'mansion' ? 60 : 100));
                avgTsuboPriceMan = Math.round(avgUnitPriceMan * 3.30578);
            }

            let officialPriceMan = officialNum ? Math.round(officialNum / 10000) : Math.round(avgUnitPriceMan * 0.9);
            let officialTsuboMan = Math.round(officialPriceMan * 3.30578);
            let roadPriceMan = Math.round(officialPriceMan * 0.8);
            let roadTsuboMan = Math.round(roadPriceMan * 3.30578);

            let divergence = officialPriceMan > 0 ? Math.round(((avgUnitPriceMan / officialPriceMan) - 1) * 100) : 0;
            let divergenceText = '';
            let divergenceColor = '#333';
            if (divergence > 15) {
                divergenceText = `実勢価格が公示比 +${divergence}%（高需要・強気相場）`;
                divergenceColor = '#d9534f';
            } else if (divergence < -15) {
                divergenceText = `実勢価格が公示比 ${divergence}%（割安・値ごろ水準）`;
                divergenceColor = '#28a745';
            } else {
                divergenceText = `公的価格とおおむね均衡（${divergence >= 0 ? '+' : ''}${divergence}%）`;
                divergenceColor = '#0056b3';
            }

            document.getElementById('avg-price').innerHTML = `${avgPriceMan.toLocaleString()} <span style="font-size:1rem;">万円</span>`;
            document.getElementById('unit-price').innerHTML = `${avgUnitPriceMan.toLocaleString()} <span style="font-size:1rem;">万円/㎡</span>`;
            document.getElementById('label-tsubo-price').textContent = `坪単価: ${avgTsuboPriceMan.toLocaleString()} 万円/坪`;
            
            document.getElementById('official-price').innerHTML = `${officialPriceMan.toLocaleString()} <span style="font-size:1rem;">万円/㎡</span>`;
            document.getElementById('official-tsubo').textContent = `公示坪単価: ${officialTsuboMan.toLocaleString()} 万円/坪`;

            document.getElementById('road-price').innerHTML = `${roadPriceMan.toLocaleString()} <span style="font-size:1rem;">万円/㎡</span>`;
            document.getElementById('road-tsubo').textContent = `路線価坪単価: ${roadTsuboMan.toLocaleString()} 万円/坪`;

            const divElem = document.getElementById('market-divergence');
            divElem.textContent = divergenceText;
            divElem.style.color = divergenceColor;

            document.getElementById('price-fluctuation').textContent = fluctuationNum != null ? `${fluctuationNum >= 0 ? '+' : ''}${fluctuationNum.toFixed(2)}%` : '+2.40%';
            document.getElementById('cap-rate').textContent = capRateNum != null ? `${capRateNum.toFixed(2)}%` : '3.80%';
            document.getElementById('trade-count').textContent = `${filteredTxs.length.toLocaleString()} 件`;
        };

        loadCharts('mansion');

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('active');
                    b.style.fontWeight = 'normal';
                    b.style.color = '#555';
                });
                e.target.classList.add('active');
                e.target.style.fontWeight = 'bold';
                e.target.style.color = 'var(--primary-color)';
                loadCharts(e.target.getAttribute('data-type'));
            });
        });
    });
</script>
